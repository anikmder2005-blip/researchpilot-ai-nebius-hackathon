# Copy to .env and fill in. NEVER commit .env.

# --- LLM provider: "nebius" (default, required for the hackathon) or "nvidia_nim" (optional alternative) ---
LLM_PROVIDER=nebius

# Nebius Token Factory (https://tokenfactory.nebius.com -> create an API key)
NEBIUS_API_KEY=your-nebius-api-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NVIDIA Nemotron model ID as listed for your account. Confirm with:  python scripts/verify_setup.py --live
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Only used when LLM_PROVIDER=nvidia_nim (NVIDIA API catalog, https://build.nvidia.com)
# NVIDIA_API_KEY=your-nvidia-api-key
# NVIDIA_NIM_MODEL=nvidia/nemotron-3-nano-30b-a3b
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1/

# Web search (https://tavily.com). Optional: without it, only uploaded documents can be researched.
TAVILY_API_KEY=your-tavily-api-key

# Embeddings for document RAG (a chat model cannot embed). Defaults to Nebius with NEBIUS_API_KEY.
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# --- Optional limits (defaults shown) ---
# AGENT_MAX_STEPS=6        # max tool calls per research run
# AGENT_MAX_ROUNDS=2       # max plan/reflect rounds
# AGENT_DEADLINE_S=240     # wall-clock budget per run
# MAX_OUTPUT_TOKENS=4096   # reasoning models spend tokens thinking; raise if answers get cut off
# REQUEST_TIMEOUT_S=90
# MAX_UPLOAD_MB=10
# DOC_TOP_K=4
# DOC_MIN_SCORE=0.25       # cosine threshold; tune for your embedding model
# DB_PATH=data/researchpilot.db
